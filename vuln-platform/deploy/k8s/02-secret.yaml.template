# TEMPLATE ONLY — every value below is a placeholder. Do not commit
# real secrets to this file or to git at all. In a real deployment,
# generate this via your secrets manager (Vault, Sealed Secrets,
# External Secrets Operator, SOPS, or at minimum `kubectl create
# secret generic --from-literal` run by hand, never checked in).
#
# VULN_AUTH_CREDENTIAL_ENCRYPTION_KEY must be EXACTLY 32 bytes — this
# is the AES-256 key protecting every SSH credential the platform
# holds for your RHEL fleet. Losing it means losing access to every
# stored credential; rotating it requires re-encrypting all existing
# credentials (see internal/crypto.KeyProvider's key-rotation design).
apiVersion: v1
kind: Secret
metadata:
  name: vuln-platform-secrets
  namespace: vuln-platform
  labels:
    app.kubernetes.io/name: vuln-platform
type: Opaque
stringData:
  VULN_DATABASE_PASSWORD: "REPLACE_ME"
  VULN_REDIS_PASSWORD: "REPLACE_ME"
  VULN_AUTH_JWT_SIGNING_KEY: "REPLACE_ME_WITH_A_LONG_RANDOM_STRING"
  VULN_AUTH_CREDENTIAL_ENCRYPTION_KEY: "REPLACE_ME_EXACTLY_32_BYTES_!!"
  # Seed admin — only consumed on first boot when no users exist yet.
  # Consider removing these three keys from the Secret entirely after
  # the first successful deploy, once an administrator account exists
  # through normal means.
  VULN_SEED_ADMIN_USERNAME: "admin"
  VULN_SEED_ADMIN_EMAIL: "admin@ubank.example"
  VULN_SEED_ADMIN_PASSWORD: "REPLACE_ME_12_CHARS_MINIMUM"
